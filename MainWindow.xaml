<Window x:Class="PatienceX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PatienceX"
        Icon="PatienceX.ico"
        Width="1260" Height="900"
        MinWidth="960" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#071E19"
        Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="76" />
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Padding="12,0">
            <MenuItem Header="_Game" Foreground="#F3F7F4">
                <MenuItem Header="_New Game" InputGestureText="F2" Click="NewGame_Click" />
                <MenuItem Header="_Restart Game" Click="Restart_Click" />
                <Separator />
                <MenuItem x:Name="DrawOneMenuItem" Header="Draw _1 Card" IsCheckable="True" Click="DrawOne_Click" />
                <MenuItem x:Name="DrawThreeMenuItem" Header="Draw _3 Cards" IsCheckable="True" Click="DrawThree_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Move" Foreground="#F3F7F4">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem Header="_Hint" InputGestureText="H" Click="Hint_Click" />
            </MenuItem>
            <MenuItem Header="_Help" Foreground="#F3F7F4">
                <MenuItem Header="_How to Play" Click="HowToPlay_Click" />
                <MenuItem Header="_About PatienceX" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Patience" FontSize="25" FontWeight="Bold" Foreground="#F3F7F4" />
                    <TextBlock Text="X" FontSize="25" FontWeight="Bold" Foreground="#73D6A5" />
                </StackPanel>
                <TextBlock Text="KLONDIKE  ·  CLASSIC SOLITAIRE" FontSize="10" FontWeight="SemiBold"
                           Foreground="#9BB2A8" Margin="1,1,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="↶  Undo" Margin="0,0,10,0" Click="Undo_Click" />
                <Button Content="✦  Hint" Margin="0,0,10,0" Click="Hint_Click" />
                <Button Content="+  New game" Background="#236347" BorderBrush="#327B58"
                        Padding="17,9" Click="NewGame_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Margin="28,0,28,12" Background="#102C24" CornerRadius="12"
                BorderBrush="#224438" BorderThickness="1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SCORE" FontSize="10" FontWeight="Bold" Foreground="#8DA99B"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ScoreText" Text="0" FontSize="19" FontWeight="SemiBold"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MOVES" FontSize="10" FontWeight="Bold" Foreground="#8DA99B"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="MovesText" Text="0" FontSize="19" FontWeight="SemiBold"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TIME" FontSize="10" FontWeight="Bold" Foreground="#8DA99B"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TimeText" Text="00:00" FontSize="19" FontWeight="SemiBold"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="3" Background="#193B30" CornerRadius="7" Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="DrawModeText" Text="DRAW 1" FontSize="10"
                               FontWeight="Bold" Foreground="#A9DDBF" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="18,0,18,8" CornerRadius="16" ClipToBounds="True">
            <Grid>
                <Grid.Background>
                    <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#176849" Offset="0" />
                        <GradientStop Color="#10523B" Offset="0.65" />
                        <GradientStop Color="#0C4433" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Background>
                <Canvas x:Name="BoardCanvas" SizeChanged="BoardCanvas_SizeChanged"
                        AllowDrop="True" DragOver="BoardCanvas_DragOver" Background="Transparent" />
                <Border x:Name="WinBanner" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="0,15,0,0" Background="#E8234335"
                        BorderBrush="#7AD6A7" BorderThickness="1" CornerRadius="10"
                        Padding="20,10" IsHitTestVisible="False">
                    <TextBlock Text="VICTORY  ·  All cards home" Foreground="#C1F4D5"
                               FontWeight="Bold" FontSize="15" />
                </Border>
                <Border x:Name="NoMovesBanner" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="0,15,0,0" Background="#E8312520"
                        BorderBrush="#D8A06F" BorderThickness="1" CornerRadius="10"
                        Padding="20,10" IsHitTestVisible="False">
                    <TextBlock Text="NO MORE MOVES  ·  Start a new game or undo"
                               Foreground="#FFE0BC" FontWeight="Bold" FontSize="14" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="30,0">
            <TextBlock x:Name="StatusText" Text="Welcome to PatienceX. Select a card, then select where it should go."
                       Foreground="#9BB2A8" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Text="F2  NEW GAME     ·     H  HINT     ·     CTRL+Z  UNDO"
                       Foreground="#597568" FontSize="9" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
